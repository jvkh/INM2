# Host directory containing the input log files and their rotated siblings.
# Absolute paths are recommended. The directory is mounted read-only at /input-logs.
INPUT_LOG_DIR=./logs
# One or more filenames in INPUT_LOG_DIR, separated by semicolons.
LOG_FILES=access.log

# Host ports published by Compose; change them if the defaults are occupied.
INM2_UI_PORT=3000
INM2_API_PORT=8000
# Internal collector control port on the Compose network; not exposed on the host.
INM2_COLLECTOR_PORT=8001

# Single-administrator application login. Generate the password hash with
# `docker compose run --rm --no-deps --entrypoint python api -m api.password_hash`
# (input is hidden) and a separate session secret
# with `openssl rand -hex 32`.
INM2_ADMIN_PASSWORD_HASH=
INM2_AUTH_SECRET=
# Keep true for HTTPS. Set false only for local HTTP development.
INM2_COOKIE_SECURE=true
# Set true to require a TOTP code; generate a key with
# `docker compose run --rm --no-deps --entrypoint python api -m api.totp_secret`.
INM2_TOTP_ENABLED=false
INM2_TOTP_SECRET=

# Import interval and incomplete-line safety margin.
INPUT_INTERVAL_SECONDS=60
INPUT_SAVE_MARGIN_CHARACTERS=4096

# Maintenance and burst detection.
MAINTENANCE_INTERVAL_DAYS=1
MAINTENANCE_INACTIVE_DAYS=90
BURST_MAX_GAP_SECONDS=5
BURST_MIN_REQUESTS=5
# BURST_WINDOW_SECONDS defaults to 60.
# Combine incidents from the same actor when more than this share of the
# shorter incident's time range overlaps. Must be an integer from 0 to 100.
INCIDENT_MERGE_OVERLAP_PERCENT=80
# Low-and-slow multi-host path scan thresholds. Minimum requests are implied by
# the required number of distinct paths.
LOW_SLOW_SCAN_WINDOW_SECONDS=10800
LOW_SLOW_SCAN_MIN_PATHS=12
LOW_SLOW_SCAN_MIN_HOSTS=2
LOW_SLOW_SCAN_MIN_SPAN_SECONDS=300

# Host directory containing optional MaxMind GeoLite2 databases, mounted read-only at /geoip.
GEOLITE_DB_DIR=./databases/geoip
# GEOLITE_CITY_DB=/geoip/GeoLite2-City.mmdb
# GEOLITE_ASN_DB=/geoip/GeoLite2-ASN.mmdb

# Optional semicolon-separated host/path-prefix entries, e.g. api.example.org/api/v1/
# IGNORE_REQUEST_ROUTES=

# Optional semicolon-separated host names that belong to this installation.
# KNOWN_HOSTS=example.org;www.example.org

# Optional semicolon-separated host names that belong to this installation.
# KNOWN_HOSTS=example.org;www.example.org
